{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 1420
    },
    {
      "name": "tauri",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "tauri", "dev"],
      "port": 1420
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5599"],
      "port": 5599
    },
    {
      "name": "vite-gallery",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_DEV_VIEWS=1&& npx vite --port 5612 --strictPort"
      ],
      "port": 5612
    },
    {
      "name": "vite-gallery-automations",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_DEV_VIEWS=1&& npx vite --port 5623 --strictPort"
      ],
      "port": 5623
    },
    {
      "name": "vite-gallery-focus",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_DEV_VIEWS=1&& npx vite --port 5641 --strictPort"
      ],
      "port": 5641
    }
  ]
}
